  "post": { "aces": false, "exposure": 1.0, "chrom_ab": 0.0 },
  "audio": { "volume": 0.0, "muted": true },
  "camera": { "mode": "orbit", "fov_deg": 40.0, "dist": 30.0, "azim_deg": 0.0, "polar_deg": 75.0 }
